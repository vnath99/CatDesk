+        task_response_diagnostics(&format!("PROBE:TASK:{old}")),
+        Some(old)
+    );
+    value["assistantHints"]
+        .as_object_mut()
+        .unwrap()
+        .remove("refusalTerms");
+    assert!(task_response_diagnostics(&format!("PROBE:TASK:{value}")).is_none());
+}
