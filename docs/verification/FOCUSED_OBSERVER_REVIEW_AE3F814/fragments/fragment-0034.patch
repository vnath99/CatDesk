+#[cfg(not(windows))]
+fn inspect_readiness(
+    _: &Store,
+    _: &str,
+    _: &Target,
+    _: Option<&crate::store::Delivery>,
+    _: Mode,
+    _: &dyn Fn() -> Result<()>,
+) -> Result<serde_json::Value> {
+    Err("READINESS_PLATFORM_UNSUPPORTED".into())
+}
