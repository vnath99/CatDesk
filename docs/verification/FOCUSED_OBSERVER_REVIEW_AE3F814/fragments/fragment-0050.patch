+        );
+        assert!(
+            WorkLedger::record_for_event(&workspace, "beta", &original.event_id)
+                .unwrap()
+                .is_none()
+        );
+        assert!(
+            WorkLedger::record_for_event(&workspace, "unobserved", &original.event_id)
