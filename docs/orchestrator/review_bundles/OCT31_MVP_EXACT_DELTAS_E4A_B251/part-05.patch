+            let ledger = WorkLedger::open(&root.0, "alpha").unwrap();
+            let at = now();
+            ledger
+                .authorize_review(
+                    ReviewGrantRequest {
+                        grant_id: input.grant_id.clone(),
+                        category: "READ_ONLY_SOURCE_REVIEW".into(),
+                        target: target.clone(),
+                        expires_utc: if expired { at - 1 } else { at + 600 },
+                        max_messages: 1,
