+                std::env::temp_dir().join(format!("review-pre-submit-{}", uuid::Uuid::new_v4())),
+            );
+            fs::create_dir_all(root.0.join(".catdesk")).unwrap();
+            let store = Store::open_scoped_for_test(&root.0.join("wake"), &root.0).unwrap();
+            store.initialize().unwrap();
