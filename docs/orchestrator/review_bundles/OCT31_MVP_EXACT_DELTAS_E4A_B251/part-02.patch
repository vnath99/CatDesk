+        if parsed.path.startswith('/auth/'):
+            return "AUTH"
+        if parsed.path in {"", "/"} and not parsed.query and not parsed.fragment:
+            return "HOME"
+    except Exception:
+        return "INVALID"
+    return "OTHER"
