+/// Explicit granted manual continuation. Uses the publication lock order from
+/// request(), not with_current_project_web_target (which holds Wake's lock).
+/// No new work record, browser, endpoint or native writer is created here.
+pub(crate) fn manual_wake(
+    workspace: &Path,
+    pins: Value,
+    key: &str,
+    task_id: &str,
+    call_id: &str,
+    arguments: Value,
+) -> Result<Value, String> {
+    let request = AssignmentRequest::parse(pins)?;
+    let intent = crate::project_mcp_task::ManualWakeRequest::parse(arguments)?;
+    let workspace = workspace
+        .canonicalize()
+        .map_err(|_| "WEB_WORK_CONTROL_UNAVAILABLE")?;
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(2);
+    loop {
+        let result = manual_wake_once(&workspace, &request, &intent, key, task_id, call_id);
+        // Only pre-effect admission contention is retryable. Journaled,
+        // submitted, unknown and arbitrary publisher errors never enter here.
+        if matches!(
+            result.as_ref().map_err(String::as_str),
+            Err("WEB_TASK_MANUAL_WAKE_ADMISSION_BUSY")
+        ) && std::time::Instant::now() < deadline
+        {
+            std::thread::sleep(std::time::Duration::from_millis(10));
+        } else {
+            return result;
+        }
+    }
+}
+
+fn manual_wake_once(
+    workspace: &Path,
