+            .unwrap();
+        job.state = QueueState::Ready; // An operator state edit is not no-effect proof.
+        queue.save_job(&job).unwrap();
+        assert!(f.resume(&source, &current, None).is_err());
+        assert_eq!(queue.jobs().unwrap().len(), 1);
+
+        let f = Fixture::new();
