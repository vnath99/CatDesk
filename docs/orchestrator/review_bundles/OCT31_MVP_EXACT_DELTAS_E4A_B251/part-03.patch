+            let parent = cold.load_job("alpha", &original.task_id).unwrap().unwrap();
+            assert_eq!(parent.state, QueueState::Paused);
+            assert_eq!(parent.request_sha256(), original.request_sha256());
+            assert_eq!(cold.jobs().unwrap().len(), 2);
