+//! Immutable task selection for the existing Web execution grant. These bytes
+//! are not authorization by themselves; the Web key/journal admits dispatch.
+use super::*;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct NativeQueueSelection {
+    pub(crate) task_id: String,
+    pub(crate) binding_sha256: String,
+    pub(crate) request_sha256: String,
+    pub(crate) maximum_seconds: u64,
+}
+
+impl NativeQueueSelection {
+    pub(crate) fn validate(&self) -> Result<(), String> {
+        if !cfg!(windows) {
+            return Err("WEB_TASK_NATIVE_PLATFORM_UNQUALIFIED".into());
+        }
+        valid_slug(&self.task_id)?;
+        if !(60..=43_200).contains(&self.maximum_seconds)
+            || [&self.binding_sha256, &self.request_sha256]
+                .iter()
+                .any(|v| !valid_sha256_hex(v) || **v != v.to_ascii_lowercase())
+        {
+            return Err("WEB_TASK_NATIVE_SELECTION_INVALID".into());
+        }
+        Ok(())
+    }
+}
+
+pub(super) fn selected_store(
+    _control: &Path,
+    controller: &AutonomousProjectV1,
+) -> Result<QueueStore, String> {
+    #[cfg(all(test, windows))]
+    if let Some((root, _)) = fixture_entry(_control) {
+        return Ok(QueueStore { root });
+    }
+    QueueStore::open_read_only(controller)?
+        .ok_or_else(|| "WEB_TASK_NATIVE_QUEUE_UNAVAILABLE".into())
+}
+
+pub(crate) fn freeze_native_queue_selection(
+    control: &Path,
+    project_id: &str,
+    task_id: &str,
+) -> Result<NativeQueueSelection, String> {
+    if !cfg!(windows) {
+        return Err("WEB_TASK_NATIVE_PLATFORM_UNQUALIFIED".into());
+    }
+    valid_slug(task_id)?;
+    let controller = resolve_registered_project_from_control_root(control, "catdesk")
+        .map_err(|_| "WEB_TASK_NATIVE_CONTROL_UNAVAILABLE")?;
+    let project = resolve_registered_project_from_control_root(control, project_id)
+        .map_err(|_| "WEB_TASK_NATIVE_PROJECT_UNAVAILABLE")?;
+    let queue = selected_store(&controller.control_workspace, &controller.project)?;
+    let _lock = queue.lock()?;
+    let job = queue
+        .load_job(project_id, task_id)?
+        .ok_or("WEB_TASK_NATIVE_TASK_UNAVAILABLE")?;
+    if job.state != QueueState::Ready || !job.binding.matches(&project.project) {
+        return Err("WEB_TASK_NATIVE_TASK_NOT_READY_OR_CHANGED".into());
+    }
+    #[cfg(all(test, windows))]
+    let maximum_seconds = if fixture_entry(control).is_some() {
+        60
+    } else {
+        turn_timeout()?.as_secs()
+    };
+    #[cfg(not(all(test, windows)))]
+    let maximum_seconds = turn_timeout()?.as_secs();
+    Ok(NativeQueueSelection {
+        task_id: task_id.into(),
+        binding_sha256: project_binding_sha256(&project.project)?,
+        request_sha256: job.request_sha256(),
+        maximum_seconds,
+    })
+}
+
+/// Metadata only. The caller retains the paired-target/registration transaction
+/// and has revalidated this exact Git-prepared project/controller snapshot.
+pub(crate) fn check_native_queue_selection_prepared(
+    prepared: &crate::delegated::autonomy_projects::PreparedProjectScopeV1,
+    selected: &NativeQueueSelection,
+) -> Result<(), String> {
+    selected.validate()?;
+    let project = prepared.scope();
+    let queue = selected_store(&project.control_workspace, prepared.controller())?;
+    let _lock = queue.lock()?;
+    if project_binding_sha256(&project.project)? != selected.binding_sha256 {
+        return Err("CODEX_QUEUE_SCOPE: exact dispatch binding changed".into());
+    }
+    let scope = CodexScope {
+        project_id: project.project.project_id.clone(),
+        workspace: project.project.workspace.clone(),
+    };
+    dispatch_jobs(
+        &queue,
+        Some((
+            &scope,
+            &selected.task_id,
+            &selected.binding_sha256,
+            Some(&selected.request_sha256),
+        )),
+    )?;
+    Ok(())
+}
+
+pub(crate) fn native_queue_selection_status(
+    control: &Path,
+    project_id: &str,
+    selected: &NativeQueueSelection,
+) -> Result<Value, String> {
+    selected.validate()?;
+    let controller = resolve_registered_project_from_control_root(control, "catdesk")
+        .map_err(|_| "WEB_TASK_NATIVE_CONTROL_UNAVAILABLE")?;
+    let project = resolve_registered_project_from_control_root(control, project_id)
+        .map_err(|_| "WEB_TASK_NATIVE_PROJECT_UNAVAILABLE")?;
+    let queue = selected_store(&controller.control_workspace, &controller.project)?;
+    let (job, lineage) = super::native_continuation::follow(&queue, project_id, selected, None)?;
+    let receipt = job
+        .receipt_id
+        .as_deref()
+        .map(|id| -> Result<QueueReceipt, String> {
+            let receipt = queue.read_receipt(id)?;
+            if receipt.project_id != project_id
+                || receipt.task_id != job.task_id
+                || job
+                    .attempt
+                    .as_ref()
+                    .is_none_or(|attempt| attempt.attempt_id != receipt.attempt_id)
+            {
+                return Err("WEB_TASK_NATIVE_RECEIPT_MISMATCH".into());
+            }
+            Ok(receipt)
+        })
+        .transpose()?;
+    Ok(
+        json!({"job":job.summary(),"receipt":receipt,"snapshotOnly":true,
+        "originTaskId":selected.task_id,"lineage":lineage,
+        "bindingStillMatches":job.binding.matches(&project.project),
+        "originalBindingStillMatches":project_binding_sha256(&project.project)? == selected.binding_sha256,
+        "processLiveness":"NOT_INFERRED_FROM_CLAIM_METADATA","taskCompletionVerified":false,
+        "nativeTurnStarted":false,"journalChanged":false}),
+    )
+}
+
+pub(crate) async fn dispatch_native_queue_selection(
+    control: &Path,
+    project_id: &str,
+    selected: &NativeQueueSelection,
+) -> Result<Value, String> {
+    selected.validate()?;
+    let controller = resolve_registered_project_from_control_root(control, "catdesk")
+        .map_err(|_| "WEB_TASK_NATIVE_CONTROL_UNAVAILABLE")?;
+    let project = resolve_registered_project_from_control_root(control, project_id)
+        .map_err(|_| "WEB_TASK_NATIVE_PROJECT_UNAVAILABLE")?;
+    let scope = CodexScope {
+        project_id: project_id.into(),
+        workspace: project.project.workspace,
+    };
+    let pins = Some((
+        &scope,
+        selected.task_id.as_str(),
+        selected.binding_sha256.as_str(),
+        Some(selected.request_sha256.as_str()),
+    ));
+    exact_dispatch_binding(control, pins)?;
+    let queue = selected_store(&controller.control_workspace, &controller.project)?;
+    let ready = {
+        let _lock = queue.lock()?;
+        dispatch_jobs(&queue, pins)?
+            .iter()
+            .any(|j| j.state == QueueState::Ready)
+    };
+    if !ready {
+        return Ok(
+            json!({"action":"codex_queue_dispatch","status":"no_ready_tasks","nativeTurnStarted":false}),
+        );
+    }
+    #[cfg(all(test, windows))]
+    let cli = if let Some((_, image)) = fixture_entry(control) {
+        preflight_selected_cli(image, None, control).await
+    } else {
+        preflight_native_cli(control).await
+    };
+    #[cfg(not(all(test, windows)))]
+    let cli = preflight_native_cli(control).await;
+    let cli = match cli {
+        Ok(cli) => cli,
+        Err(reason) => {
+            return Ok(json!({"action":"codex_queue_dispatch",
+            "status":"prelaunch_refused","reason":reason,"nativeTurnStarted":false}));
+        }
+    };
+    let Some(job) = claim_selected(control, &queue, pins)? else {
+        return Ok(
+            json!({"action":"codex_queue_dispatch","status":"no_ready_tasks","nativeTurnStarted":false}),
+        );
+    };
+    let turn = run_queued_turn(
+        &job,
+        control,
+        &cli,
+        Duration::from_secs(selected.maximum_seconds),
+    )
+    .await
+    .with_cli(&cli);
+    complete_attempt(control, &queue, &job, turn)
+}
+
+#[cfg(all(test, windows))]
+type FixtureMap = std::collections::BTreeMap<PathBuf, (PathBuf, PathBuf)>;
+#[cfg(all(test, windows))]
+static FIXTURES: std::sync::OnceLock<std::sync::Mutex<FixtureMap>> = std::sync::OnceLock::new();
+#[cfg(all(test, windows))]
+fn fixture_entry(control: &Path) -> Option<(PathBuf, PathBuf)> {
+    FIXTURES
+        .get_or_init(Default::default)
+        .lock()
+        .unwrap()
+        .get(control)
+        .cloned()
+}
+#[cfg(all(test, windows))]
+pub(crate) struct NativeQueueFixture {
+    control: PathBuf,
+    owns_map: bool,
+}
+#[cfg(all(test, windows))]
+impl NativeQueueFixture {
+    pub(crate) fn image(&self) -> PathBuf {
+        fixture_entry(&self.control).unwrap().1
+    }
+    pub(crate) fn job_file(&self, project_id: &str) -> PathBuf {
+        let root = fixture_entry(&self.control).unwrap().0;
+        QueueStore { root }.job_path(project_id, "native-fixture")
+    }
+}
+#[cfg(all(test, windows))]
+impl Drop for NativeQueueFixture {
+    fn drop(&mut self) {
+        if self.owns_map {
+            FIXTURES
+                .get()
+                .unwrap()
+                .lock()
+                .unwrap()
+                .remove(&self.control);
+        }
+    }
+}
+#[cfg(all(test, windows))]
+pub(crate) fn native_queue_fixture(control: &Path, project_id: &str) -> NativeQueueFixture {
+    let control = control.canonicalize().unwrap();
+    let project = resolve_registered_project_from_control_root(&control, project_id).unwrap();
+    let (queue, owns_map) = if let Some((root, _)) = fixture_entry(&control) {
+        (QueueStore { root }, false)
+    } else {
+        let base = control
+            .parent()
+            .unwrap()
+            .join(format!("native-queue-{}", Uuid::new_v4()));
+        fs::create_dir(&base).unwrap();
+        let queue = QueueStore::open_at(base.join("queue")).unwrap();
+        let cli = super::tests::fake_native_cli(&base);
+        assert!(
+            FIXTURES
+                .get_or_init(Default::default)
+                .lock()
+                .unwrap()
+                .insert(control.clone(), (queue.root.clone(), cli))
+                .is_none()
+        );
+        (queue, true)
+    };
+    let job = QueueJob::new(
+        "native-fixture".into(),
+        &project.project,
+        "native fixture task".into(),
+        None,
+        None,
+    )
+    .unwrap();
+    queue.save_job(&job).unwrap();
+    NativeQueueFixture { control, owns_map }
+}

diff --git a/src/operator_codex_cli/queue/owned_native.rs b/src/operator_codex_cli/queue/owned_native.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0847dbcd36c48d057ad0f163c05cee8ff66452d4
--- /dev/null
+++ b/src/operator_codex_cli/queue/owned_native.rs
@@ -0,0 +1,442 @@
+//! Bounded transport for the existing native invocation, not a new worker policy.
+//! The private Job is never disarmed. Cancellation requests cleanup even when
+//! the async caller disappears; the durable claim/marker then remain unresolved.
+
+use super::*;
+use crate::reviewed_candidate_owner::{OwnedCandidateChild, SpawnFailure};
+use std::process::Command as StdCommand;
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, Ordering},
+    mpsc,
+};
+
+#[derive(Debug)]
+pub(super) struct Transport {
+    pub outcome: &'static str,
+    pub exit_code: Option<i32>,
+    pub child_exit_observed: bool,
+    pub tree_exit_proven: bool,
+    pub no_child_created: bool,
+    pub exit_observed_at: Option<SystemTime>,
+    pub stdout: Option<CodexCliNativeStdoutEvidenceV1>,
+}
+
+impl Transport {
+    fn unknown(outcome: &'static str) -> Self {
+        Self {
+            outcome,
+            exit_code: None,
+            child_exit_observed: false,
+            tree_exit_proven: false,
+            no_child_created: false,
+            exit_observed_at: None,
+            stdout: None,
+        }
+    }
+}
+
+struct CancelOnDrop(Arc<AtomicBool>);
+impl Drop for CancelOnDrop {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::Release);
+    }
+}
+
+pub(super) async fn run(
+    command: StdCommand,
+    prompt: String,
+    evidence: CodexCliNativeStdoutEvidenceV1,
+    turn_limit: Duration,
+) -> Transport {
+    let cancel = Arc::new(AtomicBool::new(false));
+    let _cancel_on_drop = CancelOnDrop(cancel.clone());
+    tokio::task::spawn_blocking(move || {
+        run_blocking(
+            command,
+            prompt,
+            evidence,
+            turn_limit,
+            PROMPT_TIMEOUT,
+            cancel,
+        )
+    })
+    .await
+    .unwrap_or_else(|_| Transport::unknown("NATIVE_OWNER_TASK_UNOBSERVED"))
+}
+
+struct PipeWorker<T> {
+    receive: mpsc::Receiver<T>,
+    thread: std::thread::JoinHandle<()>,
+}
+impl<T: Send + 'static> PipeWorker<T> {
+    fn start(work: impl FnOnce() -> T + Send + 'static) -> std::io::Result<Self> {
+        let (send, receive) = mpsc::sync_channel(1);
+        let thread = std::thread::Builder::new()
+            .name("catdesk-native-pipe".into())
+            .spawn(move || {
+                let _ = send.send(work());
+            })?;
+        Ok(Self { receive, thread })
+    }
+    fn finish(self) -> Option<T> {
+        let value = self.receive.recv_timeout(NATIVE_STDOUT_EOF_TIMEOUT).ok()?;
+        self.thread.join().ok()?;
+        Some(value)
+    }
+}
+
+fn drain(
+    mut pipe: impl Read,
+    mut evidence: CodexCliNativeStdoutEvidenceV1,
+) -> (CodexCliNativeStdoutEvidenceV1, bool) {
+    let mut buffer = [0; 8192];
+    let mut line = Vec::new();
+    let mut oversized = false;
+    loop {
+        let count = match pipe.read(&mut buffer) {
+            Ok(n) => n,
+            Err(_) => {
+                evidence.invalidate();
+                return (evidence, false);
+            }
+        };
+        if count == 0 {
+            if !line.is_empty() || oversized {
+                evidence.invalidate();
+            }
+            evidence.mark_eof();
+            return (evidence, true);
+        }
+        for byte in &buffer[..count] {
+            if *byte == b'\n' {
+                if oversized {
+                    evidence.invalidate();
+                } else {
+                    evidence.observe_line(&line);
+                }
+                line.clear();
+                oversized = false;
+            } else if !oversized {
+                if line.len() < MAX_NATIVE_STDOUT_LINE_BYTES {
+                    line.push(*byte);
+                } else {
+                    evidence.invalidate();
+                    line.clear();
+                    oversized = true;
+                }
+            }
+        }
+    }
+}
+
+fn run_blocking(
+    mut command: StdCommand,
+    prompt: String,
+    evidence: CodexCliNativeStdoutEvidenceV1,
+    turn_limit: Duration,
+    prompt_limit: Duration,
+    cancel: Arc<AtomicBool>,
+) -> Transport {
+    if cancel.load(Ordering::Acquire) {
+        return Transport {
+            no_child_created: true,
+            ..Transport::unknown("NATIVE_CANCELLED_BEFORE_SPAWN")
+        };
+    }
+    // Same prepared args, environment and directory. Suspended assignment is
+    // performed by the existing owner before any CLI code executes.
+    let mut owner = match OwnedCandidateChild::spawn_classified(&mut command) {
+        Ok(owner) => owner,
+        Err(SpawnFailure::NoChildCreated) => {
+            return Transport {
+                no_child_created: true,
+                ..Transport::unknown("NATIVE_SPAWN_FAILED")
+            };
+        }
+        Err(failure) => {
+            return Transport {
+                tree_exit_proven: failure.quiescence_proven(),
+                ..Transport::unknown("NATIVE_OWNER_SETUP_FAILED")
+            };
+        }
+    };
+    let mut result = Transport::unknown("NATIVE_PIPE_UNAVAILABLE");
+    let mut output = None;
+    let mut input = None;
+    if let (Some(stdout), Some(mut stdin)) = (
+        owner.child_mut().stdout.take(),
+        owner.child_mut().stdin.take(),
+    ) {
+        output = PipeWorker::start(move || drain(stdout, evidence)).ok();
+        if output.is_some() {
+            input = PipeWorker::start(move || {
+                let accepted = stdin
+                    .write_all(prompt.as_bytes())
+                    .and_then(|_| stdin.flush())
+                    .is_ok();
+                drop(stdin); // Native exec - must see EOF, including on Windows.
+                accepted
+            })
+            .ok();
+        }
+    }
+    if let Some(writer) = input.as_ref() {
+        let deadline = Instant::now() + prompt_limit;
+        let accepted = loop {
+            if cancel.load(Ordering::Acquire) {
+                result.outcome = "NATIVE_CANCELLED";
+                break false;
+            }
+            match writer.receive.try_recv() {
+                Ok(value) => break value,
+                Err(mpsc::TryRecvError::Disconnected) => break false,
+                Err(mpsc::TryRecvError::Empty) if Instant::now() < deadline => {
+                    std::thread::sleep(Duration::from_millis(10))
+                }
+                Err(_) => break false,
+            }
+        };
+        if accepted {
+            let deadline = Instant::now() + turn_limit;
+            loop {
+                if cancel.load(Ordering::Acquire) {
+                    result.outcome = "NATIVE_CANCELLED";
+                    break;
+                }
+                match owner.child_mut().try_wait() {
+                    Ok(Some(status)) => {
+                        result.child_exit_observed = true;
+                        result.exit_code = status.code();
+                        result.exit_observed_at = Some(SystemTime::now());
+                        result.outcome = if status.success() {
+                            "NATIVE_EXIT_ZERO"
+                        } else {
+                            "NATIVE_EXIT_NONZERO"
+                        };
+                        break;
+                    }
+                    Ok(None) if Instant::now() < deadline => {
+                        std::thread::sleep(Duration::from_millis(10))
+                    }
+                    Ok(None) => {
+                        result.outcome = "NATIVE_TIMEOUT";
+                        break;
+                    }
+                    Err(_) => {
+                        result.outcome = "NATIVE_EXIT_UNOBSERVED";
+                        break;
+                    }
+                }
+            }
+        } else if result.outcome != "NATIVE_CANCELLED" {
+            result.outcome = "NATIVE_PROMPT_PIPE_FAILED";
+        }
+    }
+    // Parent exit alone is never cleanup proof. Retain this exact Job handle
+    // through complete descendant termination and zero-active-process readback.
+    result.tree_exit_proven = owner.terminate_tree_and_confirm_quiescent().is_ok();
+    if !result.tree_exit_proven {
+        result.outcome = "NATIVE_TREE_EXIT_UNPROVEN";
+    }
+    if let Some(writer) = input {
+        // Its single result may already have been consumed by the prompt poll.
+        // After Job cleanup, require actual thread exit rather than detaching it.
+        let deadline = Instant::now() + NATIVE_STDOUT_EOF_TIMEOUT;
+        while !writer.thread.is_finished() && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        if writer.thread.is_finished() {
+            if writer.thread.join().is_err() {
+                result.outcome = "NATIVE_PIPE_THREAD_UNOBSERVED";
+            }
+        } else {
+            result.outcome = "NATIVE_PIPE_THREAD_UNOBSERVED";
+        }
+    }
+    if let Some(reader) = output {
+        if let Some((evidence, true)) = reader.finish() {
+            result.stdout = Some(evidence);
+        } else {
+            result.outcome = "NATIVE_STDOUT_EOF_UNOBSERVED";
+        }
+    }
+    result
+}
