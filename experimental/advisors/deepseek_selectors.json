{
  "start_url": "https://chat.deepseek.com/",
  "response_container_selectors": [
    ".ds-markdown.ds-assistant-message-main-content",
    "[data-testid=\"assistant-message\"]",
    "[data-ds-role=\"assistant-response\"]",
    "article[data-role=\"assistant\"]",
    "deepseek:conversation-visible-blocks"
  ],
  "assistant_message_selectors": [
    ".ds-markdown.ds-assistant-message-main-content",
    "[data-testid=\"assistant-message\"]",
    "[data-ds-role=\"assistant-response\"]",
    "article[data-role=\"assistant\"]",
    "deepseek:conversation-visible-blocks"
  ],
  "user_message_selectors": [
    ".ds-virtual-list-visible-items > [data-virtual-list-item-key] .ds-message",
    "[data-testid=\"user-message\"]",
    "[data-ds-role=\"user-message\"]",
    "article[data-role=\"user\"]",
    "deepseek:conversation-visible-blocks"
  ],
  "prompt_input_selectors": [
    "textarea[placeholder=\"Message DeepSeek\"]",
    "textarea.ds-scroll-area",
    "textarea",
    "[contenteditable=\"true\"]"
  ],
  "send_button_selectors": [
    "button[aria-label=\"Send\"]",
    "button[data-testid=\"send-button\"]",
    "div[role=\"button\"].ds-button.ds-button--primary.ds-button--circle:not(.ds-button--disabled)",
    "deepseek:composer-send"
  ],
  "stop_button_selectors": [
    "button[aria-label=\"Stop generating\"]",
    "button[data-testid=\"stop-button\"]"
  ],
  "login_required_selectors": [
    "input[type=\"password\"]",
    "[data-testid=\"login-form\"]"
  ],
  "login_email_selectors": [
    "input[type=\"email\"]",
    "input[name=\"email\"]"
  ],
  "login_password_selectors": [
    "input[type=\"password\"]",
    "input[name=\"password\"]"
  ],
  "login_submit_selectors": [
    "button[type=\"submit\"]",
    "button[data-testid=\"login-submit\"]"
  ],
  "takeover_required_selectors": [
    "[data-testid=\"captcha\"]",
    "[data-testid=\"turnstile\"]",
    "iframe[src*=\"captcha\"]",
    "iframe[src*=\"turnstile\"]"
  ],
  "cookie_banner_selectors": [
    "#onetrust-banner-sdk",
    "[data-testid=\"cookie-banner\"]",
    "[role=\"dialog\"][aria-label=\"Cookie consent\"]"
  ],
  "cookie_reject_selectors": [
    "#onetrust-reject-all-handler",
    "button[data-testid=\"cookie-reject\"]",
    "button[aria-label=\"Reject non-essential cookies\"]"
  ],
  "cookie_accept_selectors": [
    "#onetrust-accept-btn-handler",
    "button[data-testid=\"cookie-accept\"]",
    "button[aria-label=\"Accept cookies\"]"
  ],
  "rate_limit_selectors": [
    "[data-testid=\"rate-limit-toast\"]",
    "[data-testid=\"provider-error\"]",
    "[role=\"alert\"][data-ds-error=\"rate-limit\"]"
  ],
  "chat_menu_button_selectors": [
    "button[data-testid=\"chat-menu\"]",
    "button[aria-label=\"Open chat menu\"]"
  ],
  "chat_item_selectors": [
    "[data-testid=\"chat-history-item\"]",
    "a[data-testid=\"chat-link\"]"
  ],
  "current_chat_title_selectors": [
    "[data-testid=\"current-chat-title\"]",
    "h1[data-testid=\"chat-title\"]"
  ],
  "text_stability_seconds": 5.0,
  "stable_sample_count": 3,
  "timeout_seconds": 120.0,
  "submission_confirmation_timeout_seconds": 8.0,
  "typing_min_interval_seconds": 0.03,
  "typing_max_interval_seconds": 0.09,
  "typing_newline_pause_min_seconds": 0.15,
  "typing_newline_pause_max_seconds": 0.35,
  "typing_timeout_seconds": 240.0,
  "bounded_dom_evidence_bytes": 2048
}
